{
  "name": "@mp-lb/mdcompile",
  "version": "0.0.1",
  "description": "Merge folders of markdown into one document — folders are headings, files are body.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mdcompile": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "keywords": [
    "markdown",
    "compile",
    "merge",
    "agents.md",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
